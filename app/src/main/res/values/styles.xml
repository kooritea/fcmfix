<resources>
    <style name="AppTheme" parent="Theme.Material3Expressive.DynamicColors.DayNight">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.Fcmself.Popup" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.Fcmself.MenuItem" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Fcmself.MenuStateStart" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="cornerSizeTopLeft">14dp</item>
        <item name="cornerSizeBottomLeft">14dp</item>
    </style>

    <style name="ShapeAppearance.Fcmself.MenuLabelEnd" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
    </style>

    <style name="Animation.Fcmself.FabMenu" parent="@android:style/Animation.PopupWindow">
        <item name="android:windowEnterAnimation">@anim/fab_menu_enter</item>
        <item name="android:windowExitAnimation">@anim/fab_menu_exit</item>
    </style>
</resources>
