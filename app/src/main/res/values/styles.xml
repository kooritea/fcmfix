<resources>
    <!--
        Window theme only; the visual layer is fully Compose (FcmselfTheme).
        The Material3 Expressive theme keeps edge-to-edge window styling and
        system-bar appearance in sync with the Compose content.
    -->
    <style name="AppTheme" parent="Theme.Material3Expressive.DynamicColors.DayNight">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
