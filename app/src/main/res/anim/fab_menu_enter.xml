<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <alpha
        android:duration="@integer/motion_enter_ms"
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:duration="@integer/motion_scale_ms"
        android:fromXScale="0.86"
        android:fromYScale="0.86"
        android:pivotX="100%"
        android:pivotY="100%"
        android:toXScale="1"
        android:toYScale="1" />
    <translate
        android:duration="@integer/motion_scale_ms"
        android:fromYDelta="6%"
        android:toYDelta="0" />
</set>
