<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    tools:ignore="MergeRootFrame">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/loading_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="@dimen/dock_control_height"
                android:layout_height="@dimen/dock_control_height"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/progress_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/scanning_apps"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="@dimen/grid_edge_padding"
            android:paddingTop="0dp"
            android:paddingEnd="@dimen/grid_edge_padding"
            android:paddingBottom="@dimen/grid_bottom_padding"
            android:scrollbars="none"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:text="@string/empty_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/header_safe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/header_gradient_blur"
        android:elevation="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_sm">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="normal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="@dimen/dock_search_max_width"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/dock_bottom_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/feedback_container"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/dock_gap"
            android:elevation="0dp"
            android:minHeight="@dimen/dock_search_min_height"
            android:stateListAnimator="@null"
            android:translationZ="0dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardElevation="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Fcmself.Feedback"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/dock_search_min_height"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/feedback_icon"
                    android:layout_width="@dimen/dock_control_height"
                    android:layout_height="@dimen/dock_control_height"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/dock_icon_inset"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/feedback_text"
                    android:layout_width="0dp"
                    android:accessibilityLiveRegion="polite"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"
                    android:textAlignment="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/feedback_action"
                    android:layout_width="@dimen/dock_control_height"
                    android:layout_height="@dimen/dock_control_height"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/undo"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:visibility="invisible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_container"
            android:layout_width="@dimen/dock_search_collapsed_width"
            android:layout_height="@dimen/dock_control_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/dock_gap"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:translationZ="0dp"
            app:cardElevation="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Fcmself.Search"
            app:strokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="center"
                android:hint="@string/search_hint"
                android:imeOptions="actionDone"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="@dimen/dock_search_pad_h"
                android:paddingTop="0dp"
                android:paddingEnd="@dimen/dock_search_pad_h"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottom_dock"
            android:layout_width="@dimen/dock_filter_group_width"
            android:layout_height="@dimen/dock_control_height"
            app:cardBackgroundColor="@android:color/transparent"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:translationZ="0dp"
            app:cardElevation="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Fcmself.BottomDock"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/filter_all"
                    android:layout_width="@dimen/dock_filter_segment_width"
                    android:layout_height="@dimen/dock_control_height"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:translationZ="0dp"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Fcmself.Control"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/filter_all_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/all_apps_title"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/all_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/initial_count"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/filter_fcm"
                    android:layout_width="@dimen/dock_filter_segment_width"
                    android:layout_height="@dimen/dock_control_height"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:translationZ="0dp"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Fcmself.FilterMiddle"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/filter_fcm_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fcm_filter_title"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/fcm_stats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/initial_count"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/search_toggle_container"
                    android:layout_width="@dimen/dock_control_height"
                    android:layout_height="@dimen/dock_control_height"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:translationZ="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Fcmself.FilterMiddle"
                    app:strokeWidth="0dp">

                    <ImageButton
                        android:id="@+id/search_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/search_apps"
                        android:padding="@dimen/dock_search_pad_h"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/main_fab"
                    android:layout_width="@dimen/dock_control_height"
                    android:layout_height="@dimen/dock_control_height"
                    android:contentDescription="@string/fab_content_description"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:translationZ="0dp"
                    app:backgroundTint="@android:color/transparent"
                    app:borderWidth="0dp"
                    app:elevation="0dp"
                    app:fabCustomSize="48dp"
                    app:maxImageSize="24dp"
                    app:pressedTranslationZ="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Fcmself.Control" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</FrameLayout>
